  fromAddress      String    @map("from_address")
  subject          String
  snippet          String?
  receivedAt       DateTime  @map("received_at")
  isUnread         Boolean   @default(true) @map("is_unread")
  isStarred        Boolean   @default(false) @map("is_starred")
  linkedClientId   String?   @map("linked_client_id") @db.Uuid
  linkedProjectId  String?   @map("linked_project_id") @db.Uuid
  linkedVendorId   String?   @map("linked_vendor_id") @db.Uuid
  linkedLeadId     String?   @map("linked_lead_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  project Project? @relation(fields: [linkedProjectId], references: [id])

  @@index([workspaceId, isUnread])
  @@map("emails")
