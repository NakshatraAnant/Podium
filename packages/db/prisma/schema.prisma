  project      Project?       @relation(fields: [projectId], references: [id])
  actionItems  MeetingActionItem[]

  @@map("meetings")
}

model MeetingActionItem {
  id          String    @id @default(uuid()) @db.Uuid
  meetingId   String    @map("meeting_id") @db.Uuid
  text        String
  ownerId     String    @map("owner_id") @db.Uuid
  promotedTaskId String? @map("promoted_task_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id])

  @@map("meeting_action_items")
}

// =========================================================================
// EVENT DAY
// =========================================================================

model Runsheet {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  project Project        @relation(fields: [projectId], references: [id])
  items   RunsheetItem[]

  @@map("runsheets")
}

model RunsheetItem {
  id            String    @id @default(uuid()) @db.Uuid
  runsheetId    String    @map("runsheet_id") @db.Uuid
  scheduledTime String    @map("scheduled_time") // HH:MM cue time, event-day-local
  text          String
  ownerId       String    @map("owner_id") @db.Uuid
  doneAt        DateTime? @map("done_at")
  sortOrder     Int       @default(0) @map("sort_order")

  runsheet Runsheet @relation(fields: [runsheetId], references: [id])

  @@map("runsheet_items")
}

model EventDayCheckin {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  checkedInAt DateTime @default(now()) @map("checked_in_at")

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, userId])
  @@map("event_day_checkins")
}

model EventDayIncident {
  id         String           @id @default(uuid()) @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  severity   IncidentSeverity
  text       String
  reportedById String         @map("reported_by") @db.Uuid
  raisedRiskId String?        @map("raised_risk_id") @db.Uuid // set when severity High/Critical auto-raises a risk
  createdAt  DateTime         @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("event_day_incidents")
}

// =========================================================================
// PEOPLE (operationally scoped — not a full HRMS, blueprint §22)
// =========================================================================

model Attendance {
  userId    String           @id @map("user_id") @db.Uuid
  status    AttendanceStatus @default(PRESENT)
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("attendance")
}

model Leave {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  fromDate  DateTime    @map("from_date")
  toDate    DateTime    @map("to_date")
  type      LeaveType
  status    LeaveStatus @default(PENDING)
  note      String?
  decidedById String?   @map("decided_by") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("leaves")
}

model Freelancer {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  name           String
  cityId         String    @map("city_id") @db.Uuid
  certExpiresAt  DateTime  @map("cert_expires_at") // IBG/BCII bartender certification expiry
  dayRate        Decimal   @map("day_rate") @db.Decimal(10, 2)
  eventsCount    Int       @default(0) @map("events_count")
  rating         Decimal?  @db.Decimal(2, 1)
  isAvailable    Boolean   @default(true) @map("is_available")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  city      City      @relation(fields: [cityId], references: [id])

  @@map("freelancers")
}

// =========================================================================
// KNOWLEDGE / SOPS
// =========================================================================

model Sop {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  title       String
  department  String
  ownerId     String?   @map("owner_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id])
  versions  SopVersion[]

  @@map("sops")
}

model SopVersion {
  id          String   @id @default(uuid()) @db.Uuid
  sopId       String   @map("sop_id") @db.Uuid
  versionNo   Int      @map("version_no")
  body        String
  stepsCount  Int      @default(0) @map("steps_count")
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by") @db.Uuid

  sop Sop @relation(fields: [sopId], references: [id])

  @@unique([sopId, versionNo])
  @@map("sop_versions")
}

// =========================================================================
// AUTOMATION ENGINE (blueprint §12)
// =========================================================================

model AutomationRule {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  name           String
  triggerType    String   @map("trigger_type") // event | schedule | threshold | time_relative
  triggerConfig  Json     @map("trigger_config")
  actions        Json // [{type, config}, ...]
  isEnabled      Boolean  @default(true) @map("is_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  runs      AutomationRun[]

  @@map("automation_rules")
}

model AutomationRun {
  id            String              @id @default(uuid()) @db.Uuid
  ruleId        String              @map("rule_id") @db.Uuid
  triggeredBy   String              @map("triggered_by") // entity id or "schedule"
  triggerHash   String              @map("trigger_hash") // (ruleId, entityId, triggerHash) idempotency
  status        AutomationRunStatus @default(PENDING)
  attempt       Int                 @default(1)
  error         String?
  startedAt     DateTime            @default(now()) @map("started_at")
  finishedAt    DateTime?           @map("finished_at")

  rule AutomationRule @relation(fields: [ruleId], references: [id])

  @@unique([ruleId, triggeredBy, triggerHash])
  @@map("automation_runs")
}

// =========================================================================
// NOTIFICATIONS / AUDIT
// =========================================================================

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  icon       String?
  text       String
  readAt     DateTime? @map("read_at")
  sourceType String?   @map("source_type")
  sourceId   String?   @map("source_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

/// Universal, append-only audit trail. Never updated, never deleted — written
/// exclusively by the shared audit interceptor (blueprint §7/§30), not by
/// individual endpoint handlers.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String // e.g. "invoice.issue", "flow_step.complete"
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?
  at         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  actor     User?     @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([workspaceId, at])
  @@map("audit_logs")
}

/// Backs idempotency-key support on financial/inventory mutation endpoints
/// (blueprint §7/§32). Short-lived; a cleanup job may prune rows older than
/// its retention window once introduced.
model IdempotencyKey {
  key         String   @id
  endpoint    String
  requestHash String   @map("request_hash")
  responseBody Json?   @map("response_body")
  statusCode  Int?     @map("status_code")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}
